cff-version: 1.2.0
message: "If you use TrainLens in research, please cite it using this metadata."
type: software
title: "TrainLens"
version: "0.15.1"
date-released: "2026-10-05"
abstract: "TrainLens is a notebook-first toolkit that turns machine-learning datasets and training runs into evidence for comparison, diagnosis, reproducibility, and controlled next experiments, with deterministic tabular, image, and multimodal dataset explanations, local project storage, repeated-run analysis, checkpoint selection, CI gates, and optional evidence-verified LLM improvement plans."
authors:
  - family-names: "Barrios"
    given-names: "Eduardo J."
repository-code: "https://github.com/edujbarrios/trainlens"
url: "https://github.com/edujbarrios/trainlens"
license: "Apache-2.0"
keywords:
  - "machine learning"
  - "fine-tuning"
  - "Jupyter"
  - "training runs"
  - "dataset analysis"
  - "multimodal datasets"
  - "computer vision"
  - "experiment comparison"
  - "research tooling"
