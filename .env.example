# Example only: TrainLens reads environment variables; it does not load .env automatically.
# Set these in your shell or notebook only if you use direct LLM reports.
# Use a real compatible endpoint and model; never commit real API keys.
TRAINLENS_LLM_BASE_URL=https://your-provider.example/v1
TRAINLENS_LLM_MODEL=your-model
# Omit both key settings if your local endpoint needs no authentication.
TRAINLENS_LLM_API_KEY=replace-me
# Alternative for Docker/Kubernetes mounted secrets: set the path instead.
# TRAINLENS_LLM_API_KEY_FILE=/run/secrets/trainlens_llm_key
